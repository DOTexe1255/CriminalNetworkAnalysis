# Local backend and Docker service configuration
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=tracepassword
DATABASE_URL=postgresql://trace:trace@postgres:5432/trace

# Hugging Face generation and optional embeddings
HF_TOKEN=replace_with_your_hugging_face_token
HF_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
USE_HF_EMBEDDINGS=false

# Frontend uses /api through the Nginx proxy in Compose
VITE_API_BASE_URL=/api
